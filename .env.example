# ============================================================================
#  VideoNut - Environment Variables
# ============================================================================
#  Copy this file to `.env` in the repository root (or next to config.yaml)
#  and fill in only the keys you actually use.
#
#      cp .env.example .env
#
#  `.env` is gitignored. NEVER put an API key in config.yaml - that file is
#  committed, shipped inside the npm package, and copied into every project.
#
#  The Narrator agent reads these automatically (tools/audio/tts_engine.py
#  loads the nearest .env before touching any provider).
# ============================================================================


# ---------------------------------------------------------------------------
# TEXT-TO-SPEECH PROVIDERS
# ---------------------------------------------------------------------------
# You only need ONE of these to render narration. The Narrator auto-selects
# the best *ready* provider for the script's language:
#
#   Indic languages (hi/ta/te/kn/ml/mr/gu/pa/bn/od) -> sarvam -> elevenlabs -> gemini -> edge -> mock
#   Everything else                                 -> elevenlabs -> gemini -> openai -> edge -> mock
#
# Leave them all blank and the pipeline still runs: it falls back to the free
# `edge` provider, and finally to `mock` (silent placeholder audio with exact
# timings) so the Director always has a real runtime to cut against.


# --- ElevenLabs ------------------------------------------------------------
# Default choice for English final masters. Models used by VideoNut:
#   eleven_multilingual_v2  - long-form stability (default for full documentaries)
#   eleven_v3               - expressive, understands inline audio tags
#   eleven_flash_v2_5       - cheap/fast, good for draft passes
# Get a key: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Optional: pin a specific cloned/premade voice instead of the config default.
# Find IDs at https://elevenlabs.io/app/voice-library
# ELEVENLABS_VOICE_ID=


# --- Sarvam AI (best-in-class for Indian languages) ------------------------
# bulbul:v3 beats ElevenLabs on Hindi/Tamil/Telugu naturalness, handles
# Hinglish code-switching in a single pass, and costs roughly 10x less.
# Get a key: https://dashboard.sarvam.ai
SARVAM_API_KEY=


# --- Google Gemini TTS (cheapest high-quality option) ----------------------
# gemini-3.1-flash-tts / gemini-3.8-flash-tts. Prompt-steerable delivery.
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=


# --- OpenAI TTS ------------------------------------------------------------
# gpt-4o-mini-tts / tts-1-hd. Cheapest per character, least expressive.
# Get a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=


# ---------------------------------------------------------------------------
# OPTIONAL - RESEARCH & ASSET TOOLS
# ---------------------------------------------------------------------------
# Only needed if you wire up the matching downloader in tools/downloaders/.

# Higher-quality web search for the Investigator (optional)
# TAVILY_API_KEY=
# SERPAPI_API_KEY=

# Stock footage / imagery for the Scavenger (optional)
# PEXELS_API_KEY=
# UNSPLASH_ACCESS_KEY=


# ---------------------------------------------------------------------------
# OPTIONAL - OVERRIDES
# ---------------------------------------------------------------------------
# Absolute path to an ffmpeg binary, if it is not on your PATH.
# The Narrator needs ffmpeg to concatenate segments and insert real silences.
# FFMPEG_BINARY=

# Hard cost ceiling in USD for a single narration render. The Narrator aborts
# before spending anything above this. Also settable as voice.cost_ceiling_usd.
# VIDEONUT_TTS_COST_CEILING=5.00
